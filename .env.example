# DinosecLabs — Environment template
# Copy to .env and set your own FLAG_SECRET before running setup.sh
# Generated automatically by: bash setup.sh

# HMAC secret used to derive all flag values.
# Change this to get unique flags for your deployment.
# WARNING: changing this invalidates all previously submitted flags.
FLAG_SECRET=change-me-to-a-random-secret

# Hours of inactivity before a lab is automatically stopped (default: 4)
AUTO_STOP_HOURS=4
